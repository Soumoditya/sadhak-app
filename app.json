{
  "expo": {
    "name": "Sadhak",
    "slug": "sadhak-app",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sadhak",
    "userInterfaceStyle": "automatic",
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0B0E13",
        "foregroundImage": "./assets/images/adaptive-foreground.png"
      },
      "package": "com.sadhak.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sadhak.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0E13",
          "dark": {
            "image": "./assets/images/icon.png",
            "imageWidth": 220,
            "resizeMode": "contain",
            "backgroundColor": "#0B0E13"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sadhak needs your location to show nearby temples and local festival timings."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D94F00"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sadhak needs access to your photos to set profile picture."
        }
      ],
      [
        "expo-document-picker",
        {}
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c0883ac0-ab58-44ff-9b56-c0f4ac316890"
      },
      "router": {}
    },
    "owner": "soumodityapramanik"
  }
}
