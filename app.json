{
  "expo": {
    "name": "Sadhak",
    "slug": "sadhak-app",
    "version": "1.13.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sadhak",
    "userInterfaceStyle": "automatic",
    "android": {
      "versionCode": 15,
      "adaptiveIcon": {
        "backgroundColor": "#13110F",
        "foregroundImage": "./assets/images/adaptive-foreground.png"
      },
      "package": "com.sadhak.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.SET_WALLPAPER"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sadhak.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/emblem.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F1",
          "dark": {
            "image": "./assets/images/emblem.png",
            "imageWidth": 170,
            "resizeMode": "contain",
            "backgroundColor": "#13110F"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sadhak needs your location to show nearby temples and local festival timings."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C2410C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sadhak needs access to your photos to set profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-document-picker",
        {}
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "Sadhak saves wallpapers to your gallery.",
          "savePhotosPermission": "Sadhak saves wallpapers to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "extraProguardRules": "# Shrink only, never rename (avoids reflection/JNI name breakage).\n-dontobfuscate\n-keep class expo.modules.sadhakwallpaper.** { *; }\n-keep class expo.modules.** extends expo.modules.kotlin.modules.Module { *; }\n-keep class * implements expo.modules.kotlin.records.Record { *; }\n-keepclassmembers class * { @expo.modules.kotlin.records.Field *; }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6b6e6af5-f934-4b62-bdb6-6203ed2bdafe"
      },
      "router": {}
    },
    "owner": "inactiveriteshs-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6b6e6af5-f934-4b62-bdb6-6203ed2bdafe",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
