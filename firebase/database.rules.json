{
  "rules": {
    ".read": false,
    ".write": false,

    "messages": {
      "$roomId": {
        ".read": "auth != null && (!$roomId.beginsWith('dm_') || $roomId.contains(auth.uid))",
        ".write": "auth != null && (!$roomId.beginsWith('dm_') || $roomId.contains(auth.uid))",
        ".indexOn": ["timestamp"]
      }
    },

    "typing": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "userDms": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$roomId": {
          ".write": "auth != null && $roomId.contains(auth.uid)"
        }
      }
    }
  }
}
