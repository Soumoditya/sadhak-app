{
  "rules": {
    ".read": false,
    ".write": false,

    "messages": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["timestamp"]
      }
    },

    "typing": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
