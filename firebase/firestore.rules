rules_version = '2';

// Firestore security rules for Sadhak.
// Deploy in Firebase Console -> Firestore Database -> Rules -> paste -> Publish.
// Replaces insecure "test mode" (which expires and/or allows anyone to read/write).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles: anyone signed in can view (needed for community/profiles);
    // only the owner (or an admin) may edit.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update, delete: if isOwner(uid) || isAdmin();

      // Private per-user data (notes, etc.) — owner only.
      match /{sub=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Username registry for uniqueness checks.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Published library — everyone signed in can read; only admins publish/edit.
    match /library/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // User submissions pending approval — uploader or admin can read; uploader creates; admin moderates.
    match /library_submissions/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uploadedBy == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Community groups / broadcast channels.
    match /chat_groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Future: community posts (Instagram-style feed) — read by all signed-in, write by author.
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      match /{sub=**} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
    }
  }
}
