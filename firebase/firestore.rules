rules_version = '2';

// Firestore security rules for Sadhak.
// Deploy in Firebase Console -> Firestore Database -> Rules -> paste -> Publish.
// Replaces insecure "test mode" (which expires and/or allows anyone to read/write).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles: anyone signed in can view (needed for community/profiles);
    // only the owner (or an admin) may edit.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update, delete: if isOwner(uid) || isAdmin();

      // Private per-user data (notes, etc.) — owner only.
      match /{sub=**} {
        allow read, write: if isOwner(uid);
      }

      // Follow graph: anyone signed in can see who follows whom.
      // users/{uid}/followers/{fid} is written by the follower fid;
      // users/{uid}/following/{tid} by the owner uid.
      match /followers/{fid} {
        allow read: if signedIn();
        allow create, delete: if isOwner(fid);
      }
      match /following/{tid} {
        allow read: if signedIn();
        allow create, delete: if isOwner(uid);
      }
    }

    // Username registry for uniqueness checks.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Published library — everyone signed in can read; only admins publish/edit.
    match /library/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      // Anyone signed in may bump only the rating totals and download count.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount', 'downloadCount']);

      // One rating per person per book.
      match /ratings/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner(uid)
          && (request.method == 'delete' || (request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5));
      }
    }

    // User submissions pending approval — uploader or admin can read; uploader creates; admin moderates.
    match /library_submissions/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uploadedBy == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Community groups / broadcast channels.
    match /chat_groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Community-added temples & bhandaras — read by all signed-in; author creates; author/admin moderates.
    match /community_places/{placeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.addedBy == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.addedBy == request.auth.uid || isAdmin());
    }

    // Community posts — read by all signed-in, write by author. Others may
    // only change the like and comment counters.
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'commentCount']);
      match /{sub=**} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
    }
  }
}
